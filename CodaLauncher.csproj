<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodaLauncher</AssemblyName>
    <ApplicationIcon>packaging/windows/CodaLauncher.ico</ApplicationIcon>
    <RootNamespace>HowlingWhispers.CodaLauncher</RootNamespace>
    <Version>0.7.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="auth/microsoft.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="Desktop/**/*.cs" />
  </ItemGroup>
</Project>

