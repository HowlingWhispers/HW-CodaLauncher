<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CodaLauncher</AssemblyName>
    <Version>0.6.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.21" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.21" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.21" />
    <Compile Include="../LauncherCore.cs" Link="Shared/LauncherCore.cs" />
    <Compile Include="../LauncherModels.cs" Link="Shared/LauncherModels.cs" />
    <Compile Include="../ManagedMods.cs" Link="Shared/ManagedMods.cs" />
    <Content Include="../web/assets/coda-headshot.png" Link="assets/coda-headshot.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
