<Window x:Class="HowlingWhispers.CodaLauncher.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CodaLauncher Update"
 Width="820" Height="560" MinWidth="720" MinHeight="500"
 WindowStartupLocation="CenterScreen"
 Background="#050B0F"
 Foreground="#D7F4FA"
 Loaded="OnLoaded"
 Closing="OnClosing">
 <Grid Margin="24">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Margin="0,0,0,6">
   <TextBlock Text="CODA // UPDATE DESK" Foreground="#67DDF5" FontFamily="Consolas" FontWeight="Bold" FontSize="14"/>
   <TextBlock Text="clipboard online" Foreground="#7399A3" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0"/>
  </StackPanel>
  <TextBlock x:Name="VersionText" Grid.Row="1" Foreground="#B9DCE4" FontFamily="Consolas" FontSize="13" Margin="0,0,0,14"/>
  <Border Grid.Row="2" Background="#02070A" BorderBrush="#17313A" BorderThickness="1" CornerRadius="8" Padding="14">
   <TextBox x:Name="Terminal" Background="Transparent" BorderThickness="0" Foreground="#CBEAF2" FontFamily="Consolas" FontSize="13" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
  </Border>
  <ProgressBar x:Name="DownloadProgress" Grid.Row="3" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#67DDF5" Background="#102128" Margin="0,16,0,8"/>
  <TextBlock x:Name="StatusText" Grid.Row="4" Text="Coda is checking the paperwork..." Foreground="#8FB5BF" FontFamily="Consolas" FontSize="12" Margin="0,0,0,16"/>
  <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="ContinueButton" Content="CONTINUE WITHOUT UPDATE" Visibility="Collapsed" Click="Continue_Click" Padding="18,10" Margin="0,0,10,0" Background="#12262D" Foreground="#D7F4FA" BorderBrush="#31535D" FontWeight="SemiBold"/>
   <Button x:Name="RebootButton" Content="REBOOT CODALAUNCHER ▶" IsEnabled="False" Click="Reboot_Click" Padding="22,10" Background="#1B7F98" Foreground="White" BorderBrush="#67DDF5" FontWeight="Bold"/>
  </StackPanel>
 </Grid>
</Window>
